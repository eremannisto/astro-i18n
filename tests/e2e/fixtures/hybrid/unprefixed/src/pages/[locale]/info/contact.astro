---
import { Locale } from "@mannisto/astro-i18n/runtime"

export const getStaticPaths = () => {
  return Locale.supported.map((code) => {
    return {
      params: {
        locale: code,
      },
    }
  })
}

const { code } = Locale.use(Astro)
---

<html lang={code}>
  <body>
    <h1 data-testid="contact">Contact</h1>
  </body>
</html>
